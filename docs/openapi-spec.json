{
  "openapi": "3.0.0",
  "info": {
    "title": "Proposal Drafting API",
    "description": "An API for generating, managing, and exporting project proposals for UN agencies and NGOs.",
    "version": "0.0.1",
    "termsOfService": "http://www.unhcr.org",
    "contact": {
      "name": "Edouard Legoupil",
      "url": "http://edouard-legoupil.github.io",
      "email": "legoupil@unhcr.org"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8502",
      "description": "Local development server"
    },
    {
      "url": "https://api.proposaldrafter.unhcr.org",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication and authorization"
    },
    {
      "name": "Session Management",
      "description": "User session management"
    },
    {
      "name": "Proposals",
      "description": "Proposal creation and management"
    },
    {
      "name": "Documents",
      "description": "Document upload and management"
    },
    {
      "name": "Users",
      "description": "User profile and management"
    },
    {
      "name": "Knowledge",
      "description": "Knowledge base access"
    },
    {
      "name": "Metrics",
      "description": "API usage metrics"
    },
    {
      "name": "Admin",
      "description": "Administrative functions"
    },
    {
      "name": "Donor Templates",
      "description": "Donor template management"
    },
    {
      "name": "Template Management",
      "description": "Template administration"
    },
    {
      "name": "Incidents",
      "description": "Incident reporting"
    },
    {
      "name": "Qualification",
      "description": "Proposal qualification"
    },
    {
      "name": "Health & Debugging",
      "description": "Health monitoring and debugging"
    },
    {
      "name": "SharePoint",
      "description": "SharePoint integration"
    }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user",
        "description": "Authenticate user and return JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sso-status": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Check SSO status",
        "description": "Check if SSO authentication is available",
        "responses": {
          "200": {
            "description": "SSO status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether SSO is enabled"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": ["Session Management"],
        "summary": "Get current session",
        "description": "Get information about the current user session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/proposals": {
      "get": {
        "tags": ["Proposals"],
        "summary": "List proposals",
        "description": "List all proposals accessible to the current user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by proposal status",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of proposals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Proposals"],
        "summary": "Create proposal",
        "description": "Create a new proposal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/proposals/{proposal_id}": {
      "get": {
        "tags": ["Proposals"],
        "summary": "Get proposal",
        "description": "Get detailed information about a specific proposal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "description": "ID of the proposal",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Proposal not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/upload": {
      "post": {
        "tags": ["Documents"],
        "summary": "Upload document",
        "description": "Upload a document for processing",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Document file to upload"
                  },
                  "document_type": {
                    "type": "string",
                    "description": "Type of document"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}": {
      "get": {
        "tags": ["Documents"],
        "summary": "Get document",
        "description": "Get information about a specific document",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "description": "ID of the document",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get current user",
        "description": "Get profile information for the current user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "description": "List all users (admin only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "name": "role",
            "in": "query",
            "description": "Filter by user role",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/cards": {
      "get": {
        "tags": ["Knowledge"],
        "summary": "Get knowledge cards",
        "description": "Retrieve knowledge cards from the knowledge base",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter by knowledge category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "List of knowledge cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeCardsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/usage": {
      "get": {
        "tags": ["Metrics"],
        "summary": "Get usage metrics",
        "description": "Get API usage metrics (admin only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "description": "Time period for metrics",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["day", "week", "month"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "post": {
        "tags": ["Admin"],
        "summary": "Create user",
        "description": "Create a new user (admin only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/templates": {
      "get": {
        "tags": ["Donor Templates"],
        "summary": "List templates",
        "description": "List available donor templates",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/templates": {
      "post": {
        "tags": ["Template Management"],
        "summary": "Upload template",
        "description": "Upload a new donor template (admin only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Template file to upload"
                  },
                  "donor": {
                    "type": "string",
                    "description": "Donor organization name"
                  },
                  "description": {
                    "type": "string",
                    "description": "Template description"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents": {
      "post": {
        "tags": ["Incidents"],
        "summary": "Report incident",
        "description": "Report a new incident",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentReportRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Incident reported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/qualification/check": {
      "post": {
        "tags": ["Qualification"],
        "summary": "Check qualification",
        "description": "Check if a proposal meets qualification criteria",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualificationCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health & Debugging"],
        "summary": "Health check",
        "description": "Check API health status",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sharepoint/sync-status": {
      "get": {
        "tags": ["SharePoint"],
        "summary": "Get sync status",
        "description": "Get SharePoint synchronization status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sync status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharePointSyncResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication using Bearer token"
      }
    },
    "parameters": {
      "limitParam": {
        "name": "limit",
        "in": "query",
        "description": "Number of items to return",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "offsetParam": {
        "name": "offset",
        "in": "query",
        "description": "Starting position for pagination",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "User password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token"
          },
          "token_type": {
            "type": "string",
            "enum": ["bearer"],
            "description": "Token type"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token expiration time in seconds"
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "User ID"
          },
          "username": {
            "type": "string",
            "description": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "User roles"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Session expiration time"
          }
        }
      },
      "ProposalListResponse": {
        "type": "object",
        "properties": {
          "proposals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProposalSummary"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of proposals"
          },
          "limit": {
            "type": "integer",
            "description": "Number of items per page"
          },
          "offset": {
            "type": "integer",
            "description": "Current offset"
          }
        }
      },
      "ProposalSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proposal ID"
          },
          "title": {
            "type": "string",
            "description": "Proposal title"
          },
          "status": {
            "type": "string",
            "description": "Proposal status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owner user ID"
          }
        }
      },
      "ProposalCreateRequest": {
        "type": "object",
        "required": ["title", "template_id"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Proposal title"
          },
          "template_id": {
            "type": "string",
            "format": "uuid",
            "description": "Template ID to use"
          },
          "context": {
            "type": "string",
            "description": "Context for proposal generation"
          },
          "additional_data": {
            "type": "object",
            "description": "Additional data for proposal"
          }
        }
      },
      "ProposalResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proposal ID"
          },
          "title": {
            "type": "string",
            "description": "Proposal title"
          },
          "status": {
            "type": "string",
            "description": "Proposal status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          }
        }
      },
      "ProposalDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proposal ID"
          },
          "title": {
            "type": "string",
            "description": "Proposal title"
          },
          "status": {
            "type": "string",
            "description": "Proposal status"
          },
          "content": {
            "type": "string",
            "description": "Proposal content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owner user ID"
          },
          "template_id": {
            "type": "string",
            "format": "uuid",
            "description": "Template ID used"
          }
        }
      },
      "DocumentUploadResponse": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "description": "Document ID"
          },
          "filename": {
            "type": "string",
            "description": "Original filename"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "mime_type": {
            "type": "string",
            "description": "File MIME type"
          },
          "status": {
            "type": "string",
            "description": "Processing status"
          }
        }
      },
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Document ID"
          },
          "filename": {
            "type": "string",
            "description": "Original filename"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "mime_type": {
            "type": "string",
            "description": "File MIME type"
          },
          "status": {
            "type": "string",
            "description": "Processing status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload timestamp"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Processing completion timestamp"
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "User ID"
          },
          "username": {
            "type": "string",
            "description": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email"
          },
          "full_name": {
            "type": "string",
            "description": "Full name"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "User roles"
          },
          "settings": {
            "type": "object",
            "description": "User settings"
          }
        }
      },
      "UserListResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
