## this env file is used to set environment variables for the backend application when running it locally without a Docker container

### Database Connection
DB_USERNAME=""
DB_PASSWORD=""
DB_NAME="postgres"
DB_HOST=""
DB_PORT="5432"

## Models
CLOUD_PROVIDER="azure" # local or gcp

# Inference
AZURE_OPENAI_ENDPOINT=""
OPENAI_API_VERSION=""
AZURE_OPENAI_API_KEY=""
AZURE_DEPLOYMENT_NAME=""

# Embedding
AZURE_EMBEDDING_MODEL=""
AZURE_OPENAI_ENDPOINT_EMBED=""
AZURE_OPENAI_API_KEY_EMBED=""
AZURE_EMBEDDING_DEPLOYMENT_NAME=""
AZURE_OPENAI_API_VERSION_EMBED=""

CREWAI_TELEMETRY_ENABLED=False

# JWT Secret for authentication
SECRET_KEY=""

# Search Key
SERPER_API_KEY=""

## Cloudfare auth...
cfAccessClientId=""
cfAccessClientSecret=""

# - EntraID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# APP_ENV=development  # Required for local callback inference; do not use for deployed environments.
# With that explicit setting, local development infers http://localhost:8502/api/callback when unset.
# In all other environments, set the exact registered callback URI.
# ENTRA_REDIRECT_URI="https://proposal.example/api/callback"

# Required in production; optional in local development (defaults to http,https).
SCRAPER_ALLOWED_SCHEMES="http,https"
